FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /factoryops-api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /factoryops-api /factoryops-api
EXPOSE 8080
ENTRYPOINT ["/factoryops-api"]
